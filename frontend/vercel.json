{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@11.0.9 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.0.9 run build",
  "git": { "deploymentEnabled": false },
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "will-ly-portfolio-staging.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}

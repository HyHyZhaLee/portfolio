{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./backend/gradlew -p backend assemble *)",
      "Bash(./backend/gradlew -p backend compileJava *)",
      "Bash(./backend/gradlew -p backend testUnit *)",
      "Bash(./backend/gradlew -p backend testIT *)",
      "Bash(./backend/gradlew -p backend test *)",
      "Bash(./backend/gradlew -p backend spotlessApply *)",
      "Bash(./backend/gradlew -p backend spotlessCheck *)",
      "Bash(./backend/gradlew -p backend check *)",
      "Bash(./backend/gradlew -p backend jacocoTestReport *)",
      "Bash(./backend/gradlew -p backend tasks *)",
      "Bash(./backend/gradlew -p backend --offline *)",
      "Bash(scripts/with-node.sh node --version)",
      "Bash(scripts/with-node.sh pnpm --dir frontend build *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend check:type *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend check:lint *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend check:format *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend format *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend test *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend coverage *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend gen:api *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend install --frozen-lockfile *)",
      "Bash(scripts/with-node.sh pnpm --dir frontend install --offline *)",
      "Bash(scripts/check-services.sh)",
      "Bash(make help)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make ps)",
      "Bash(make status)",
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make format)",
      "Bash(make openapi)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose port *)",
      "Bash(docker info *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(lsof -nP *)"
    ],
    "ask": [
      "Bash(make reset)",
      "Bash(docker compose down -v *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)"
    ]
  }
}

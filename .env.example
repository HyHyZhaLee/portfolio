# Copy to .env to override local defaults. .env is gitignored; never put real secrets in this template.
# Every value below is a local-development default. Production values live only in the Render and Vercel settings.

# Host ports
POSTGRES_PORT=5432
SERVER_PORT=8080
FRONTEND_PORT=5173

# Local PostgreSQL started by compose.yaml
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# Backend profile: local on a developer machine
SPRING_PROFILES_ACTIVE=local
# Origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
# HMAC key for visitor hashes. Development only; production uses its own random value.
VISITOR_HASH_SECRET=dev-only-secret
# X-Forwarded-For entries added by trusted proxies, counted from the right (Render: confirmed in PF-012)
TRUSTED_PROXY_HOPS=1
# PF-004 D3: logs the raw X-Forwarded-For once per start; leave false except for the one PF-012 check
LOG_FORWARDED_FOR_ONCE=false
# How old the footer's stats summary may be (PF-005); optional, 60s when unset
STATS_CACHE_TTL=60s
# Leave empty locally: the local profile logs contact message IDs instead of sending email. Every other profile
# fails at startup without RESEND_API_KEY and CONTACT_TO_EMAIL (the owner's inbox), which only Render holds (PF-006 D14).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional, so commented out: an exported empty value would replace the default.
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Where the backend runs, lowercase letters only: production (the default), staging, or local (the local profile sets it).
# Outside production, contact emails get a "[<name>] " subject prefix; /actuator/info reports it (PF-027).
# APP_ENVIRONMENT=production
# CONTACT_RETRY_ENABLED=true
# GitHub user whose public repositories are listed (PF-007); the token is optional everywhere (it only raises the rate limit).
GITHUB_USERNAME=HyHyZhaLee
GITHUB_TOKEN=
# GITHUB_FEATURED=BK2023_Thesis_SmartPole,portfolio
# GITHUB_CACHE_TTL=1h

# Copy to .env to override local defaults. .env is gitignored; never put real secrets in this template.
# Every value below is a local-development default. Production values live only in the Render and Vercel settings.

# Host ports
POSTGRES_PORT=5432
SERVER_PORT=8080
FRONTEND_PORT=5173

# Local PostgreSQL started by compose.yaml
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio

# Backend profile: local on a developer machine
SPRING_PROFILES_ACTIVE=local
# Origins allowed by CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173
# HMAC key for visitor hashes. Development only; production uses its own random value.
VISITOR_HASH_SECRET=dev-only-secret
# X-Forwarded-For entries added by trusted proxies, counted from the right (Render: confirmed in PF-012)
TRUSTED_PROXY_HOPS=1
# PF-004 D3: logs the raw X-Forwarded-For once per start; leave false except for the one PF-012 check
LOG_FORWARDED_FOR_ONCE=false
# Leave empty locally: the local profile logs contact message IDs instead of sending email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# GitHub user whose public repositories are listed; a token is optional locally (it only raises the rate limit).
GITHUB_USERNAME=HyHyZhaLee
GITHUB_TOKEN=

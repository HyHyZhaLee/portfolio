{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Visit counting, contact messages, and public GitHub projects for the portfolio site.",
    "title" : "Portfolio API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/contact-messages" : {
      "post" : {
        "operationId" : "createContactMessage",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateContactMessageRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "tags" : [ "contact-controller" ]
      }
    },
    "/api/v1/projects" : {
      "get" : {
        "operationId" : "listProjects",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProjectListResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "project-controller" ]
      }
    },
    "/api/v1/stats/summary" : {
      "get" : {
        "operationId" : "getStatsSummary",
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/StatsSummaryResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "stats-controller" ]
      }
    },
    "/api/v1/visits" : {
      "post" : {
        "operationId" : "recordVisit",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RecordVisitRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "Accepted"
          }
        },
        "tags" : [ "visit-controller" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateContactMessageRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "format" : "email",
            "maxLength" : 254,
            "minLength" : 0
          },
          "message" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 10,
            "pattern" : "[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]*"
          },
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0,
            "pattern" : "[^\\p{Cntrl}]*"
          },
          "website" : {
            "type" : "string",
            "maxLength" : 2048,
            "minLength" : 0
          }
        },
        "required" : [ "email", "message", "name" ]
      },
      "ProjectListResponse" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ProjectResponse"
            }
          }
        },
        "required" : [ "items" ]
      },
      "ProjectResponse" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : [ "string", "null" ]
          },
          "homepage" : {
            "type" : [ "string", "null" ]
          },
          "language" : {
            "type" : [ "string", "null" ]
          },
          "name" : {
            "type" : "string"
          },
          "stars" : {
            "type" : "integer",
            "format" : "int32"
          },
          "topics" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "updatedAt" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "url" : {
            "type" : "string"
          }
        },
        "required" : [ "name", "stars", "topics", "url" ]
      },
      "RecordVisitRequest" : {
        "type" : "object",
        "properties" : {
          "path" : {
            "type" : "string",
            "maxLength" : 255,
            "minLength" : 0,
            "pattern" : "/[^?#\\x00-\\x1F\\x7F]*"
          },
          "ref" : {
            "type" : "string",
            "maxLength" : 256,
            "minLength" : 0
          },
          "referrer" : {
            "type" : "string",
            "maxLength" : 2048,
            "minLength" : 0
          }
        },
        "required" : [ "path" ]
      },
      "StatsSummaryResponse" : {
        "type" : "object",
        "properties" : {
          "since" : {
            "type" : [ "string", "null" ],
            "format" : "date-time"
          },
          "totalViews" : {
            "type" : "integer",
            "format" : "int64"
          },
          "uniqueVisitors" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "totalViews", "uniqueVisitors" ]
      }
    }
  }
}
